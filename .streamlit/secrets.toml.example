# Save as C:\Users\<you>\.streamlit\secrets.toml (outside the shared folder).
# Without it, or if SurveyCTO can't be reached, the dashboard reads
# data/puff2_verification_anonymized.xlsx
[surveycto]
server = "your-server"                    # <server>.surveycto.com
username = "api.user@laterite.com"
password = "********"
form_id = "clasp_puff_verification_r1"
# SurveyCTO server dataset holding the sample roster. Leave out to use
# data/CLASP_PUFF_2.0_Sample_Roster.xlsx on this computer.
roster_id = "clasp_puff_roster_r1"
