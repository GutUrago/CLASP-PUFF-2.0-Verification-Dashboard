# Rename to secrets.toml to pull data straight from SurveyCTO.
# Without this file (or if SurveyCTO can't be reached) the dashboard reads
# data/puff2_verification_anonymized.xlsx
[surveycto]
server = "your-server"                    # <server>.surveycto.com
username = "api.user@laterite.com"
password = "********"
form_id = "clasp_puff_2.0_verification_r1"
private_key_path = "C:/keys/puff2_private.pem"   # the form is encrypted
